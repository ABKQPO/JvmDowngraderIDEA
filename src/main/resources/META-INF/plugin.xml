<idea-plugin>
    <id>com.hfstudio.jvmdowngraderidea</id>
    <name>JVM Downgrader</name>
    <resource-bundle>messages.JvmDowngraderBundle</resource-bundle>
    <vendor url="https://github.com/HFStudio">HFStudio</vendor>
    <description><![CDATA[
        Parses JVM Downgrader and Jabel dependency source attachments at their required Java language level.<br>
        It does not change the language level configured in Project Structure for project files.
    ]]></description>

    <idea-version since-build="261.24374" until-build="261.*"/>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends>org.jetbrains.plugins.gradle</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.hfstudio.jvmdowngraderidea.settings.JvmDowngraderApplicationSettings"/>
        <projectService serviceImplementation="com.hfstudio.jvmdowngraderidea.settings.JvmDowngraderProjectSettings"/>
        <projectService serviceImplementation="com.hfstudio.jvmdowngraderidea.library.LibrarySourceRefreshCoordinator"/>
        <projectConfigurable
                id="com.hfstudio.jvmdowngraderidea.projectSettings"
                displayName="%settings.title"
                parentId="tools"
                instance="com.hfstudio.jvmdowngraderidea.settings.JvmDowngraderProjectConfigurable"/>
        <filePropertyPusher implementation="com.hfstudio.jvmdowngraderidea.library.LibraryJavaLanguageLevelPusher"/>
        <backgroundPostStartupActivity implementation="com.hfstudio.jvmdowngraderidea.library.LibrarySourceStartupActivity"/>
        <statusBarWidgetFactory
                id="JvmDowngraderLibrarySourceLanguageLevel"
                implementation="com.hfstudio.jvmdowngraderidea.library.LibrarySourceLanguageLevelWidgetFactory"/>
    </extensions>
</idea-plugin>
