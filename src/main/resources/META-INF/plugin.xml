<idea-plugin>
    <id>com.hfstudio.jvmdowngraderidea</id>
    <name>JVM Downgrader</name>
    <vendor url="https://github.com/HFStudio">HFStudio</vendor>
    <description><![CDATA[
        Keeps the IntelliJ Java language level aligned with GTNH Gradle projects that use JVM Downgrader or Jabel.<br>
        Gradle remains the build authority; existing libraries, source attachments, navigation, and multi-release JAR handling remain native to IntelliJ IDEA.
    ]]></description>

    <idea-version since-build="261.24374" until-build="261.*"/>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends>org.jetbrains.plugins.gradle</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.hfstudio.jvmdowngraderidea.settings.JvmDowngraderApplicationSettings"/>
        <projectService serviceImplementation="com.hfstudio.jvmdowngraderidea.settings.JvmDowngraderProjectSettings"/>
        <projectService serviceImplementation="com.hfstudio.jvmdowngraderidea.refresh.ModernJavaRefreshCoordinator"/>
        <applicationConfigurable
                id="com.hfstudio.jvmdowngraderidea.settings"
                displayName="JVM Downgrader"
                parentId="tools"
                instance="com.hfstudio.jvmdowngraderidea.settings.JvmDowngraderConfigurable"/>
        <projectConfigurable
                id="com.hfstudio.jvmdowngraderidea.projectSettings"
                displayName="JVM Downgrader"
                parentId="tools"
                instance="com.hfstudio.jvmdowngraderidea.settings.JvmDowngraderProjectConfigurable"/>
        <backgroundPostStartupActivity implementation="com.hfstudio.jvmdowngraderidea.refresh.ModernJavaStartupActivity"/>
    </extensions>
</idea-plugin>
